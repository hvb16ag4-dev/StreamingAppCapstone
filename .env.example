# Shared
CLIENT_URLS=http://localhost:3000
JWT_SECRET=changeme
MONGO_DB=streamingapp
# Set IMAGE_PREFIX to a Docker Hub namespace/repository prefix to publish images,
# for example docker.io/your-user/streamingapp.
IMAGE_PREFIX=streamingappcapstone
IMAGE_TAG=latest
# AWS
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
AWS_CDN_URL=

# Services
AUTH_PORT=3001
STREAMING_PORT=3002
STREAMING_PUBLIC_URL=http://localhost:3002

# Frontend build-time values
REACT_APP_AUTH_API_URL=http://localhost:3001/api
REACT_APP_STREAMING_API_URL=http://localhost:3002/api
REACT_APP_STREAMING_PUBLIC_URL=http://localhost:3002
