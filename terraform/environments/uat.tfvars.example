project_name              = "streamingapp"
environment               = "uat"
aws_region                = "ap-south-1"
cluster_version           = "1.37"
cluster_public_access_cidrs = ["203.0.113.10/32"] # Replace with the UAT team's trusted egress CIDR.
vpc_cidr                  = "10.20.0.0/16"
availability_zone_count   = 2
node_instance_type        = "t3.medium"
desired_capacity          = 1
min_capacity              = 1
max_capacity              = 2
local_dev_access_enabled = false # Set true to allow the exact IAM Identity Center role(s) below.
local_dev_access_principal_arns = [] # Add approved UAT-account IAM role ARNs before enabling local DEV access.
